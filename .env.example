DATABASE_URL=sqlite+aiosqlite:///./data/software_quality_agent.sqlite
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
QUALITY_BACKEND_URL=http://127.0.0.1:8000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUGGESTION_BASE_URL=http://127.0.0.1:18000/v1
SUGGESTION_API_KEY=local
SUGGESTION_MODEL=qwen35-9b
# Interactive console only; formal review has no segment-wide turn cap.
SUGGESTION_MAX_TURNS=256
REVIEW_PASSAGE_MAX_TURNS=24
REVIEW_SUPPLEMENTAL_PASSAGE_LIMIT=8
REVIEW_MODEL_RETRY_LIMIT=1
REVIEW_PIPELINE=fixed_tlr
SUGGESTION_MODEL_CALL_TIMEOUT_SECONDS=180
SUGGESTION_SESSION_DB=artifacts/suggestion_agent_sessions.sqlite3
SUGGESTION_CHECKPOINT_DIR=artifacts/suggestion_agent_checkpoints
